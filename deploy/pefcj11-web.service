[Unit]
Description=PEcj11 Flask website (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/pefcj11
EnvironmentFile=/var/www/pefcj11/.env
ExecStart=/var/www/pefcj11/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
